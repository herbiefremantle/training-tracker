# Create an app at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Only change if you run on a different port:
# STRAVA_REDIRECT_URI=http://localhost:8000/auth/callback

# --- login (multi-account; see README "Login") ---
# Sets up the FIRST account (an admin, who can invite others) the first time the app starts. Every account
# after that comes from an invite the admin creates in the app. Optional locally; REQUIRED when deployed (the
# Docker image refuses to start without it). 8+ characters (12+ recommended).
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# APP_PASSWORD=
# Username for that first account. Defaults to "pete" if unset.
# ADMIN_USERNAME=
# Signs and checks login sessions - a secret separate from any one account's password. REQUIRED when deployed.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SESSION_SECRET=
# Most accounts the app will allow (including the admin). Matches Strava's self-serve "10 athletes" API app
# capacity by default - raise your Strava app's capacity first if you raise this.
# MAX_USERS=10
# Creates a fixed, shared, read-only demo/demo login with self-updating sample data, for sharing the app with
# people who don't want to connect their own Strava - see README "Demo account".
# DEMO_ACCOUNT=1
# The demo account's password. Defaults to "demo" if unset - change this if a browser's breached-password
# checker (e.g. Chrome's) flags that as a known-leaked password, which it commonly does. Takes effect on the
# next restart, whether the account already exists or not.
# DEMO_PASSWORD=

# --- only for deployment (Railway sets most of these itself; see README "Deploy to Railway") ---
# Your public domain if you use a custom one, comma-separated. Railway's own domain is picked up automatically.
# ALLOWED_HOSTS=train.example.com
# Path of the SQLite file. The Docker image sets /data/app.db (the Railway volume); leave unset locally.
# FITNESS_DB=
